    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.8.0",
    "mongoose": "^8.6.1",
    "multer": "^1.4.5-lts.1",
    "next": "14.2.15",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tesseract.js": "^5.1.0",

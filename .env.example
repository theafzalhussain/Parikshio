# Parikshio — environment template
# Copy to .env and fill in. Without MongoDB/Redis the server boots in
# "ephemeral engine" mode (in-memory store + in-memory cache) and behaves identically.

PORT=3000

# Public origin of the website, used for canonical URLs, the sitemap and
# share images. Default: https://parikshio.tech
# NEXT_PUBLIC_SITE_URL=https://parikshio.tech

# Split deployment: set this in the Vercel frontend project to the public
# Render backend URL, for example https://axiom-api.onrender.com.
# Leave blank when the UI and API run on the same origin.
NEXT_PUBLIC_API_URL=

# ── Auth / session ─────────────────────────────────────────────
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if this is missing or left as the default.
JWT_SECRET=
# How long a login stays valid (e.g. 15m, 12h, 7d). Default: 12h
SESSION_TTL=12h

# ── Offline-first submissions ──────────────────────────────────
# A student device that loses its connection saves answers locally and replays
# them on reconnect. Development defaults to a 45-second delivery grace.
# Production always requires 0 because client clocks cannot prove when an answer
# was written; an answer must arrive before the question closes.
# OFFLINE_SYNC_GRACE_MS=45000

# ── Reverse proxy ───────────────────────────────────────────────
# Optional comma-separated proxy IPs/CIDRs. Leave blank unless requests arrive
# through a trusted proxy whose addresses you control; forwarded IP headers from
# all other sources are ignored.
TRUSTED_PROXIES=

# Comma-separated browser origins allowed to call the API and open Socket.io.
# For split deployment, set this on Render to the Vercel production URL and
# any preview URL that needs access, for example:
# ALLOWED_ORIGINS=https://axiom.vercel.app,https://www.example.com
ALLOWED_ORIGINS=

# ── MongoDB (persistence) ──────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/axiom_live
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/axiom_live?retryWrites=true&w=majority
MONGODB_URI=

# ── Redis (caching of live exam state, leaderboards, analytics) ─
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# ── Firebase (Google sign-in) ──────────────────────────────────
# Firebase console → Project settings → Your apps → Web app.
# Leave blank to disable Google sign-in; the button renders disabled with a hint.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional — only used so the web app matches the console config exactly.
NEXT_PUBLIC_FIREBASE_APP_ID=
# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID — used to verify ID tokens server-side.
FIREBASE_PROJECT_ID=

# ── Google Classroom (teacher roster + assessment results) ────
# Enable the Google Classroom API in Google Cloud and configure the OAuth
# consent screen. The redirect URI must match this app's callback exactly:
#   Local: http://localhost:3000/api/classroom/oauth/callback
#   Prod:  https://your-app.example.com/api/classroom/oauth/callback
# OAuth client must be a Web application. Keep the secret server-side only.
GOOGLE_CLASSROOM_CLIENT_ID=948825952514-2fs1cs72qecjampdhrfv6v1lgipl3vbc.apps.googleusercontent.com
GOOGLE_CLASSROOM_CLIENT_SECRET=

# ── Brevo (transactional email — password reset + contact form) ─
# Leave blank to disable email; the password-reset flow then falls back to the
# dev console link, and contact messages are only stored in the database.
# Sender email must be a VERIFIED sender in your Brevo account, or on a domain
# authenticated in Brevo (Settings → Senders, Domains, IPs). Write the value
# with a single "=" and no quotes, for example:
#   BREVO_SENDER_EMAIL=support@parikshio.tech
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Parikshio

# Where contact-form messages and faculty access requests are emailed (the
# person who wrote in is set as reply-to).
# Default: support@parikshio.tech
# CONTACT_INBOX_EMAIL=support@parikshio.tech

# Public origin used to build password-reset links. Required in production and
# must use HTTPS. Never derive reset links from request Host headers.
# Local: http://localhost:3000   ·   Prod: https://your-app.onrender.com
APP_URL=

# ── Gemini (AI evaluation of Short / Long answers) ─────────────
# Google AI Studio → API keys. New keys start with "AQ." (auth keys); both
# formats are sent via the x-goog-api-key header. Leave blank to disable AI
# grading: short answers then match their key, long answers go to manual review.
GEMINI_API_KEY=
# Optional — model chain tried in order; overloaded/retired models are skipped.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
# Optional — reasoning depth (minimal | low | medium | high). Default: low
# GEMINI_THINKING_LEVEL=low
# Optional — per-request timeout in ms. Default: 30000
# GEMINI_TIMEOUT_MS=30000
# Optional — parallel AI requests. Default: 3
# AI_GRADING_CONCURRENCY=3
# Optional — answers to the same question graded in one request (max 25). Default: 10
# Batching keeps a class of 60–100 inside Gemini's per-minute / per-day quotas.
# AI_GRADING_BATCH_SIZE=10
# Optional — log every Gemini call (model, HTTP status, latency; never answer text)
# AI_GRADING_DEBUG=false
# Set to false to run AI grading only when an admin asks for it. Default: true
# AI_AUTO_GRADE=true

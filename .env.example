# Axiom Live — environment template
# Copy to .env and fill in. Without MongoDB/Redis the server boots in
# "ephemeral engine" mode (in-memory store + in-memory cache) and behaves identically.

PORT=3000

# ── Auth / session ─────────────────────────────────────────────
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if this is missing or left as the default.
JWT_SECRET=
# How long a login stays valid (e.g. 15m, 12h, 7d). Default: 12h
SESSION_TTL=12h

# ── Offline-first submissions ──────────────────────────────────
# A student device that loses its connection saves answers locally and replays
# them on reconnect. This is the extra window (ms) in which a replayed answer is
# still accepted after its question closed — it buys delivery time for a device
# that was offline at the buzzer, not thinking time (the replay must still claim
# a submit time inside the question's own window). Default: 45000. Set to 0 to
# refuse any answer that arrives after its question closed.
# OFFLINE_SYNC_GRACE_MS=45000

# ── MongoDB (persistence) ──────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/axiom_live
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/axiom_live?retryWrites=true&w=majority
MONGODB_URI=

# ── Redis (caching of live exam state, leaderboards, analytics) ─
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# ── Firebase (Google sign-in) ──────────────────────────────────
# Firebase console → Project settings → Your apps → Web app.
# Leave blank to disable Google sign-in; the button renders disabled with a hint.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional — only used so the web app matches the console config exactly.
NEXT_PUBLIC_FIREBASE_APP_ID=
# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID — used to verify ID tokens server-side.
FIREBASE_PROJECT_ID=

# ── Brevo (transactional email — password reset link) ──────────
# Leave blank to disable email; the password-reset flow then falls back to the
# dev console link. Sender email must be a VERIFIED sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Parikshio

# Absolute URL of the deployed app, used to build links inside emails.
# Local: http://localhost:3000   ·   Prod: https://your-app.onrender.com
APP_URL=

# ── Gemini (AI evaluation of Short / Long answers) ─────────────
# Google AI Studio → API keys. New keys start with "AQ." (auth keys); both
# formats are sent via the x-goog-api-key header. Leave blank to disable AI
# grading: short answers then match their key, long answers go to manual review.
GEMINI_API_KEY=
# Optional — model chain tried in order; overloaded/retired models are skipped.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
# Optional — reasoning depth (minimal | low | medium | high). Default: low
# GEMINI_THINKING_LEVEL=low
# Optional — per-request timeout in ms. Default: 30000
# GEMINI_TIMEOUT_MS=30000
# Optional — parallel AI requests. Default: 3
# AI_GRADING_CONCURRENCY=3
# Optional — answers to the same question graded in one request (max 25). Default: 10
# Batching keeps a class of 60–100 inside Gemini's per-minute / per-day quotas.
# AI_GRADING_BATCH_SIZE=10
# Optional — log every Gemini call (model, HTTP status, latency; never answer text)
# AI_GRADING_DEBUG=false
# Set to false to run AI grading only when an admin asks for it. Default: true
# AI_AUTO_GRADE=true
